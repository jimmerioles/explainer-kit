{
  "name": "explainer-kit",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic house-style explainer films: narration, canvas render, mix and master.",
  "bin": {
    "explainer": "./bin/explainer.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "node bin/explainer.mjs doctor",
    "check": "node scripts/check.mjs",
    "clean": "node scripts/clean.mjs",
    "verify": "node bin/explainer.mjs verify",
    "verify:wave": "node bin/explainer.mjs verify --project examples/wave"
  },
  "dependencies": {
    "kokoro-js": "1.2.1",
    "msedge-tts": "2.1.1",
    "playwright-core": "1.65.1",
    "sharp": "0.35.5"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
